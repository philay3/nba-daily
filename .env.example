# Copy to .env at the repo root. The pipeline and the web app both read this one file.

# Postgres connection string.
# Local database from docker-compose.yml:
DATABASE_URL=postgresql://nba:nba@localhost:5432/nba_daily
# Neon (production): use the pooled connection string, with sslmode=require.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Default handle printed on studio graphics (each template also has a text field).
NEXT_PUBLIC_BRAND_HANDLE=@nbadaily
